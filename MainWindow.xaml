<Window x:Class="MobileTransferPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mobile Transfer Pro" Height="760" Width="1100" MinHeight="650" MinWidth="900" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="#F4F6FA">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#173B78" CornerRadius="12" Padding="18" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Mobile Transfer Pro" FontSize="26" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="نقل بيانات الموبايلات — اختر المصدر والوجهة بنفسك" FontSize="15" Foreground="#E4ECFF" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <GroupBox Header="الهاتف المصدر — النقل منه" Grid.Column="0" Margin="0,0,7,0" Padding="10">
        <StackPanel>
          <ComboBox x:Name="SourceDeviceBox" Height="34" DisplayMemberPath="DisplayName"/>
          <TextBlock Text="اختر الجهاز الذي يحتوي على البيانات الأصلية" Foreground="#606A7A" Margin="2,6,0,0"/>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="الهاتف المستهدف — النقل إليه" Grid.Column="1" Margin="7,0,7,0" Padding="10">
        <StackPanel>
          <ComboBox x:Name="TargetDeviceBox" Height="34" DisplayMemberPath="DisplayName"/>
          <TextBlock Text="لن يبدأ النقل قبل تأكيد الجهازين" Foreground="#606A7A" Margin="2,6,0,0"/>
        </StackPanel>
      </GroupBox>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
        <Button x:Name="RefreshButton" Content="تحديث الأجهزة" Click="RefreshButton_Click" Background="#2457C5" Foreground="White"/>
        <Button x:Name="SwapButton" Content="تبديل الاتجاه" Click="SwapButton_Click"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="أنواع البيانات المتاحة في النسخة الأولية" Grid.Column="0" Margin="0,0,12,0" Padding="12">
        <StackPanel>
          <TextBlock Text="حدد المجلدات التي تريد نقلها. لا يتم حذف بيانات المصدر." TextWrapping="Wrap" Margin="0,0,0,12"/>
          <CheckBox x:Name="DcimCheck" Content="الكاميرا (DCIM)" IsChecked="True" Margin="3,5"/>
          <CheckBox x:Name="PicturesCheck" Content="الصور (Pictures)" IsChecked="True" Margin="3,5"/>
          <CheckBox x:Name="MoviesCheck" Content="الفيديوهات (Movies)" IsChecked="True" Margin="3,5"/>
          <CheckBox x:Name="DownloadCheck" Content="التنزيلات (Download)" IsChecked="True" Margin="3,5"/>
          <CheckBox x:Name="DocumentsCheck" Content="المستندات (Documents)" IsChecked="True" Margin="3,5"/>
          <CheckBox x:Name="MusicCheck" Content="الموسيقى (Music)" IsChecked="False" Margin="3,5"/>
          <CheckBox x:Name="WhatsAppMediaCheck" Content="وسائط واتساب المتاحة" IsChecked="False" Margin="3,5"/>
          <Separator Margin="0,14"/>
          <TextBlock Text="مهم" FontWeight="Bold" Foreground="#9A4B00"/>
          <TextBlock Text="هذه النسخة الأولية تنقل الملفات المشتركة فقط. لا تنقل بعدُ الرسائل أو جهات الاتصال أو سجل المكالمات أو قاعدة محادثات واتساب الخاصة." TextWrapping="Wrap" Margin="0,5,0,0"/>
          <Button x:Name="StartTransferButton" Content="بدء النقل" Click="StartTransferButton_Click" Background="#18864B" Foreground="White" Height="42" Margin="0,18,0,0"/>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="حالة العملية وسجل النقل" Grid.Column="1" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="StatusText" Text="وصّل الهاتفين، فعّل USB debugging على أندرويد، ووافق على رسالة الثقة في كل هاتف." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10"/>
          <ProgressBar x:Name="TransferProgress" Grid.Row="1" Height="13" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
          <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </Grid>
      </GroupBox>
    </Grid>
    <TextBlock Grid.Row="3" Text="تنبيه: لا توصل هاتف زبون أو تبدأ النقل دون موافقته. تأكد من المصدر والوجهة قبل كل عملية." Foreground="#586273" Margin="2,12,2,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
